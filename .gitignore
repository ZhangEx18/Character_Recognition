# ==========================================
# CNN 字符识别项目 - Git 忽略清单 (.gitignore)
# ==========================================

# 1. 虚拟环境 (绝不提交，每个人的操作系统和本地依赖位置不同)
venv/
.venv/
env/

# 2. 数据集与输出结果 (体积庞大，通常通过网盘分享或给出下载脚本)
data/
outputs/

# 3. 模型权重与日志 (二进制大文件，Git 极不擅长处理)
checkpoints/
logs/

# 4. Python 编译缓存 (运行自动生成的临时文件)
__pycache__/
*.pyc
*.pyo

# 5. 操作系统与 IDE 专属配置 (避免干扰其他协作者的环境)
.DS_Store
.idea/
.vscode/